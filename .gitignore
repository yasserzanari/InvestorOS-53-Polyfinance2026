# New maintained documentation is versioned; existing local notes and research stay ignored.
/docs/*
!/docs/README.md
!/docs/architecture/
!/docs/development/
!/docs/design/
!/docs/product/

# JavaScript
node_modules/
apps/web/dist/
apps/api/build/
.npm/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Local configuration and secrets
.env
.env.*
!.env.example
!apps/web/.env.aws.example
AWS_ADMIN_CREDENTIALS.txt
.aws/

# Terraform
**/.terraform/*
infrastructure/terraform/bootstrap/backend.tf
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
!*.example.tfvars

# Editors and OS
.DS_Store
.idea/
.vscode/

# TypeScript
*.tsbuildinfo
