# Non-secret local development example. The launcher exports defaults itself.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
PROFILE_API_PORT=8010
# AWS credentials come from the standard boto3 credential chain / IAM role.
# Never put AWS credentials in frontend VITE_* configuration.
# Optional: read DEV2 analysis history through the restricted Lambda Invoke entry.
# Use an AWS SSO profile/role with lambda:InvokeFunction only on the research API function.
# RESEARCH_LAMBDA_FUNCTION=investoros-dev-api
